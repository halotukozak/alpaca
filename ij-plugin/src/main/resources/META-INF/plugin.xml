<idea-plugin>
  <id>com.halotukozak.alpaca.plugin</id>
  <name>Alpaca</name>
  <vendor>halotukozak</vendor>
  <description><![CDATA[
    IDE support for languages defined with the <a href="https://github.com/halotukozak/alpaca">Alpaca</a> lexer/parser library.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="com.halotukozak.alpaca.plugin.startup.AlpacaGrammarStartupActivity"/>
    <projectConfigurable
        parentId="tools"
        instance="com.halotukozak.alpaca.plugin.settings.AlpacaSettingsConfigurable"
        id="com.halotukozak.alpaca.plugin.settings.AlpacaSettingsConfigurable"
        displayName="Alpaca"/>
    <lang.syntaxHighlighterFactory
        language="Alpaca"
        implementationClass="com.halotukozak.alpaca.plugin.lexer.AlpacaSyntaxHighlighterFactory"/>
    <lang.parserDefinition
        language="Alpaca"
        implementationClass="com.halotukozak.alpaca.plugin.parser.AlpacaParserDefinition"/>
    <lang.psiStructureViewFactory
        language="Alpaca"
        implementationClass="com.halotukozak.alpaca.plugin.structure.AlpacaStructureViewFactory"/>
    <lang.foldingBuilder
        language="Alpaca"
        implementationClass="com.halotukozak.alpaca.plugin.folding.AlpacaFoldingBuilder"/>
    <completion.contributor
        language="Alpaca"
        implementationClass="com.halotukozak.alpaca.plugin.completion.AlpacaCompletionContributor"/>
    <lang.commenter
        language="Alpaca"
        implementationClass="com.halotukozak.alpaca.plugin.commenter.AlpacaCommenter"/>
  </extensions>
</idea-plugin>
